# Sonos speaker static seed IPs (JSON object or comma-separated room:ip)
# Only one reachable speaker IP is needed to expand the full topology via unicast visible_zones.
SPEAKER_IPS={"living_room": "192.168.1.100", "kids_room": "192.168.1.101", "bedroom": "192.168.1.102"}
DEFAULT_ROOM=living_room

# Discovery & SoCo network timeouts
SOCO_REQUEST_TIMEOUT=5.0
DISCOVERY_TIMEOUT=2.0
CACHE_TTL_SECONDS=180
FAVORITES_CACHE_TTL_SECONDS=300
APPLE_MUSIC_COUNTRY=IL

# Optional volume safety caps & quiet hours (0-23; supports overnight wrap like 21 -> 7)
# MAX_VOLUME_BY_ROOM={"kids_room": 40, "bedroom": 40}
# QUIET_HOURS_START=21
# QUIET_HOURS_END=7
# QUIET_HOURS_MAX_VOLUME=30

# Local Ollama natural-language voice router
OLLAMA_URL=http://ollama:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30.0
OLLAMA_CONNECT_TIMEOUT=3.0
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false

# Optional HTTP & Streamable HTTP MCP security
# Set SONOS_API_KEY to require `Authorization: Bearer <key>` or `X-API-Key: <key>` on /command and /mcp
# SONOS_API_KEY=change-me-to-a-strong-random-token
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_HOSTS=localhost,127.0.0.1,sonos-voice-agent

# Logging & scenes
LOG_LEVEL=INFO
SCENES_PATH=scenes.json
